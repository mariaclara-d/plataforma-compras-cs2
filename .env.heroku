# 🚀 VARIÁVEIS DE AMBIENTE PARA HEROKU
# Configure estas variáveis no Dashboard Heroku ou via CLI

# === CONFIGURAÇÕES BÁSICAS ===
FLASK_ENV=production
SECRET_KEY=sua_chave_secreta_super_segura_aqui
WTF_CSRF_ENABLED=True

# === CONFIGURAÇÕES DE SITE ===
SITE_URL=https://sua-app.herokuapp.com
SITE_NAME=CS2 Marketplace

# === STEAM API (OBRIGATÓRIO) ===
# Obtenha em: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=sua_steam_api_key_aqui

# === STEAM WEB API (OPCIONAL - para trades automáticos) ===
STEAMWEBAPI_URL=https://sua-steamwebapi.com
STEAMWEBAPI_USERNAME=seu_usuario
STEAMWEBAPI_PASSWORD=sua_senha

# === TWILIO (OPCIONAL - para notificações WhatsApp) ===
TWILIO_ACCOUNT_SID=seu_twilio_sid
TWILIO_AUTH_TOKEN=seu_twilio_token
WHATSAPP_NUMBER=seu_numero_whatsapp

# === CONFIGURAÇÕES DE TRADING ===
TRADE_COMPANY_NAME=Sua Empresa
TRADE_COMPANY_URL=https://sua-empresa.com

# === BANCO DE DADOS ===
# Heroku configura automaticamente DATABASE_URL
# Não precisa configurar manualmente

# === LOGS E DEBUG ===
LOG_LEVEL=INFO
DEBUG=False