"""Servico Steam otimizado e organizado
Remove duplicacoes e separa responsabilidades
"""

import asyncio
import json
import logging
import os
import base64
from pathlib import Path
from dotenv import load_dotenv

from aiosteampy.client import SteamClient
from aiosteampy.constants import AppContext

from models import TradeOffer, InformacoesPagamento
from .steam_utils import (
    extrair_partner_steamid, 
    steamid32_to_steamid64, 
    validar_dados_requisicao,
    registrar_oferta_no_banco,
    extrair_token_tradelink
)

# Configuracoes
load_dotenv()
COOKIE_FILE = Path("config/steam/cookies.json")
COOKIE_FILE.parent.mkdir(parents=True, exist_ok=True)

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class SteamClientManager:
    """Manager centralizado para operacoes Steam"""
    
    def __init__(self):
        self.client = None
        self.username = os.getenv('STEAM_USERNAME')
        self.password = os.getenv('STEAM_PASSWORD')
        self.steam_id = os.getenv('STEAM_ID')
        
        # Carregar secrets do arquivo JSON
        self._load_steam_guard_secrets()
    
    def _load_steam_guard_secrets(self):
        """Carrega secrets do arquivo de configuracao"""
        try:
            config_file = Path("config/steam/steam_guard.json")
            with open(config_file, 'r') as f:
                config = json.load(f)
            
            self.shared_secret = config['shared_secret']
            self.identity_secret = config['identity_secret']
            
            logger.info(f"[AUTH] Secrets carregados: {len(self.shared_secret)} chars cada")
            
        except Exception as e:
            logger.error(f"[ERROR] Erro ao carregar secrets: {e}")
            raise
    
    def _validate_base32_secrets(self):
        """Valida se os secrets sao Base32 validos"""
        try:
            # Adicionar padding se necessario
            for secret_name in ['shared_secret', 'identity_secret']:
                secret = getattr(self, secret_name)
                missing_padding = len(secret) % 8
                if missing_padding:
                    secret += '=' * (8 - missing_padding)
                    setattr(self, secret_name, secret)
                
                # Validar decodificacao
                decoded = base64.b32decode(secret)
                if len(decoded) != 20:
                    raise ValueError(f"{secret_name} deve ter 20 bytes apos decodificacao")
                
                logger.info(f"[AUTH] {secret_name} Base32 valido ({len(decoded)} bytes)")
                
        except Exception as e:
            raise ValueError(f"Secrets nao sao Base32 validos: {e}")
    
    async def get_authenticated_client(self):
        """Retorna cliente Steam autenticado com cache de sessao"""
        
        # Tentar usar sessao em cache
        if await self._try_cached_session():
            return self.client
        
        # Login completo
        return await self._perform_full_login()
    
    async def _try_cached_session(self):
        """Tenta usar sessao em cache"""
        if not COOKIE_FILE.exists():
            return False
        
        try:
            with COOKIE_FILE.open("r") as f:
                cookies = json.load(f)
            
            self.client = SteamClient(
                steam_id=self.steam_id, 
                username=self.username,
                password=self.password,
                shared_secret=self.shared_secret,
                identity_secret=self.identity_secret
            )
            
            # Restaurar cookies
            from aiosteampy.utils import restore_from_cookies
            await restore_from_cookies(cookies, self.client)
            
            # Verificar se sessao ainda valida
            if await self.client.is_session_alive():
                logger.info("[INFO] Sessao Steam restaurada do cache")
                return True
            else:
                logger.warning("[WARN] Sessao em cache expirada")
                return False
                
        except Exception as e:
            logger.warning(f"[WARN] Falha ao restaurar sessao: {e}")
            return False
    
    async def _perform_full_login(self):
        """Realiza login completo com retry robusto"""
        
        logger.info("[AUTH] Realizando login completo...")
        
        # Validar credenciais
        self._validate_base32_secrets()
        
        # Tentar login com retry
        max_attempts = 3
        delays = [15, 60, 120]  # Delays progressivos
        
        for attempt in range(max_attempts):
            try:
                # Garantir que attempt e max_attempts sao int
                attempt_num = int(attempt)
                max_att = int(max_attempts)
                
                logger.info(f"[AUTH] Tentativa de login {attempt_num + 1}/{max_att}")
                
                # Criar novo cliente para cada tentativa
                self.client = SteamClient(
                    steam_id=self.steam_id,
                    username=self.username,
                    password=self.password,
                    shared_secret=self.shared_secret,
                    identity_secret=self.identity_secret
                )
                
                # Delay anti-rate-limit
                if int(attempt) > 0:
                    delay_time = float(delays[int(attempt) - 1])
                    logger.info(f"[AUTH] Aguardando {delay_time}s...")
                    await asyncio.sleep(delay_time)
                else:
                    await asyncio.sleep(15.0)  # Delay inicial
                
                # Tentar login
                await self.client.login()
                
                # Salvar cookies em caso de sucesso
                await self._save_session_cookies()
                
                logger.info("[INFO] Login Steam realizado com sucesso!")
                return self.client
                
            except KeyError as e:
                error_key = str(e).strip("'\"")
                logger.error(f"[ERROR] Tentativa {int(attempt) + 1} falhou: KeyError('{error_key}')")
                
                if error_key in ['client_id', 'access_token'] and int(attempt) < int(max_attempts) - 1:
                    logger.warning("[WARN] Steam API com problemas, recriando cliente...")
                    continue
                else:
                    raise Exception(f"Steam API nao esta retornando {error_key}. Tente novamente mais tarde.")
                    
            except Exception as e:
                logger.error(f"[ERROR] Erro no login: {e}")
                if int(attempt) == int(max_attempts) - 1:
                    raise
                    
        raise Exception("Falha apos todas as tentativas de login")
    
    async def _save_session_cookies(self):
        """Salva cookies da sessao para cache"""
        try:
            cookies = await self.client.get_cookies()
            with COOKIE_FILE.open("w") as f:
                json.dump(cookies, f, indent=2)
            logger.info("[INFO] Cookies salvos para proxima sessao")
        except Exception as e:
            logger.warning(f"[WARN] Falha ao salvar cookies: {e}")

class SteamTradeManager:
    """Manager para operacoes de trade"""
    
    def __init__(self, client_manager):
        self.client_manager = client_manager
    
    async def send_trade_offer(self, tradelink, asset_ids, message=""): # Adicionar async
        """Envia oferta de trade"""
        
        try:
            # Garantir que asset_ids s o inteiros
            if isinstance(asset_ids, list):
                asset_ids = [int(x) for x in asset_ids]
            else:
                asset_ids = [int(asset_ids)]
            
            # Obter cliente autenticado
            client = await self.client_manager.get_authenticated_client()
            
            # Extrair dados do tradelink
            partner_raw = extrair_partner_steamid(tradelink)
            if not partner_raw:
                raise ValueError("Tradelink inv lido - partner n o encontrado")
            
            partner_steamid64 = steamid32_to_steamid64(partner_raw)
            
            # Extrair token
            token = extrair_token_tradelink(tradelink)
            if not token:
                raise ValueError("Token n o encontrado no tradelink")
            
            # Criar assets para trade
            assets = []
            for asset_id in asset_ids:
                assets.append({
                    'assetid': str(asset_id),
                    'appid': 730, # CS:GO
                    'contextid': '2'
                })
            
            # Enviar oferta
            logger.info(f"[SEND] Enviando oferta para {partner_steamid64} com {len(assets)} itens")
            
            response = await client.send_trade_offer(
                partner_steam_id=partner_steamid64,
                items_to_give=assets,
                items_to_receive=[],
                message=message,
                trade_offer_access_token=token
            )
            
            if response and hasattr(response, 'tradeofferid'):
                offer_id = response.tradeofferid
                
                # Registrar no banco
                registrar_oferta_no_banco(offer_id, partner_steamid64)
                
                logger.info(f"[OK] Oferta enviada com sucesso! ID: {offer_id}")
                
                return {
                    'success': True,
                    'tradeoffer_id': offer_id,
                    'message': f'Oferta enviada com sucesso! ID: {offer_id}'
                }
            else:
                raise Exception("Resposta inv lida da Steam - sem offer ID")
        
        except Exception as e:
            logger.error(f"[ERROR] Erro ao enviar oferta: {e}")
            return {
                'success': False,
                'error': str(e),
                'message': f'Erro ao enviar oferta: {e}'
            }

# Inst ncias globais (singleton pattern)
_client_manager = None
_trade_manager = None

def get_client_manager():
    """Singleton para client manager"""
    global _client_manager
    if _client_manager is None:
        _client_manager = SteamClientManager()
    return _client_manager

def get_trade_manager():
    """Singleton para trade manager"""
    global _trade_manager
    if _trade_manager is None:
        _trade_manager = SteamTradeManager(get_client_manager())
    return _trade_manager

# Fun o principal para compatibilidade com c digo existente
async def enviar_oferta_principal(partner_steamid64, items_dict, message="Trade offer from TitoSkins"):
    """
    Fun o principal para envio de ofertas
    Compat vel com a chamada em routes/trade.py
    """
    try:
        # Extrair tradelink e asset_ids do items_dict
        tradelink = items_dict.get("tradelink")
        items = items_dict.get("items", [])
        asset_ids = [item["assetid"] for item in items]
        
        if not tradelink:
            raise ValueError("Tradelink n o fornecido em items_dict")
        
        if not asset_ids:
            raise ValueError("Nenhum asset_id fornecido")
        
        trade_manager = get_trade_manager()
        return await trade_manager.send_trade_offer(tradelink, asset_ids, message)
    
    except Exception as e:
        logger.error(f"[ERROR] enviar_oferta_principal: {e}")
        return {
            'success': False,
            'error': str(e),
            'message': f'Erro ao processar oferta: {e}'
        }

