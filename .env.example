# ARQUIVO EXEMPLO - NÃO COLOCAR DADOS REAIS AQUI
# Copie este arquivo para .env e preencha com suas credenciais reais

# Configurações da aplicação
COMPANY_NAME=YourCompany
STEAM_COMMUNITY_URL=https://steamcommunity.com

# Steam API Keys
STEAM_API_KEY_NAO_OFICIAL=sua_chave_api_alternativa_aqui
STEAM_API_KEY=sua_chave_steam_api_oficial_aqui

# SteamWebAPI Key (serviço terceirizado)  
STEAMWEBAPI_KEY=sua_chave_steamwebapi_aqui

# Steam Guard (Bot Steam)
STEAM_GUARD_FILE=config/steam/steam_guard.json
STEAM_USERNAME=seu_usuario_steam_bot
STEAM_PASSWORD=sua_senha_steam_bot
STEAM_SHARED_SECRET=seu_shared_secret_aqui
STEAM_IDENTITY_SECRET=seu_identity_secret_aqui

# URLs do Steam
STEAM_RETURN_URL=http://127.0.0.1:5000/complete_steam_login
STEAM_REALM=http://127.0.0.1:5000

# Chave secreta do Flask (gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=gere_uma_chave_secreta_segura_aqui

# Database (PostgreSQL)
SQLALCHEMY_DATABASE_URI=postgresql://usuario:senha@host:porta/nome_banco

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=seu_account_sid_twilio
TWILIO_AUTH_TOKEN=seu_auth_token_twilio
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+seu_numero_destino

# Configurações de Produção
FLASK_ENV=production
DATABASE_URL=sua_url_banco_producao
HEROKU_APP_NAME=seu_app_heroku
