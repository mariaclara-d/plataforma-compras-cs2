# .env.production - Configuração para produção PostgreSQL
# Use este arquivo como base para configurar variáveis de produção

# Configuração de ambiente
FLASK_ENV=production
DEBUG=False

# Steam API Keys (REGENERAR PARA PRODUÇÃO!)
STEAM_API_KEY_NAO_OFICIAL=NOVA_CHAVE_AQUI
STEAM_API_KEY=NOVA_CHAVE_STEAM_AQUI

# Steam Guard (CONFIGURAR BOT DE PRODUÇÃO!)
STEAM_GUARD_FILE=steam_guard_prod.json
STEAM_USERNAME=bot_producao
STEAM_PASSWORD=SENHA_SUPER_SEGURA
STEAM_SHARED_SECRET="NOVO_SHARED_SECRET"
STEAM_IDENTITY_SECRET="NOVO_IDENTITY_SECRET"

# URLs de produção
STEAM_RETURN_URL=https://seu-app.herokuapp.com/complete_steam_login
STEAM_REALM=https://seu-app.herokuapp.com

# Secret Key (GERAR NOVA PARA PRODUÇÃO!)
SECRET_KEY=NOVA_CHAVE_SUPER_SEGURA_AQUI

# HEROKU POSTGRESQL (configurado automaticamente)
# DATABASE_URL=postgresql://username:password@hostname:port/database
# Heroku define esta variável automaticamente quando você adiciona o addon PostgreSQL

# OU POSTGRESQL MANUAL (VPS/outro provedor)
# DB_HOST=seu-servidor-postgres.com
# DB_PORT=5432
# DB_NAME=csgo_skins_prod
# DB_USER=csgo_user
# DB_PASSWORD=senha_super_segura

# Twilio (USAR CREDENCIAIS DE PRODUÇÃO!)
TWILIO_ACCOUNT_SID=SEU_SID_PRODUCAO
TWILIO_AUTH_TOKEN=SEU_TOKEN_PRODUCAO
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+5574999619371

# Configurações de produção
RATE_LIMIT_ENABLED=True
SECURITY_LOGGING=True

# Configurações SSL (Heroku configura automaticamente)
PGSSLMODE=require
