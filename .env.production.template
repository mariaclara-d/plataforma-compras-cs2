# CONFIGURAÇÃO DE PRODUÇÃO - TEMPLATE SEGURO
# =============================================
# IMPORTANTE: Copie este arquivo para .env.production e preencha com valores reais
# NUNCA commite arquivos .env no repositório!

# CONFIGURAÇÃO GERAL
# ===================
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_APP=app.py

# CHAVE SECRETA (OBRIGATÓRIA)
# ============================
# GERE UMA CHAVE SECRETA FORTE DE 32+ caracteres
# Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ALTERE_ESTA_CHAVE_SECRETA_POR_UMA_FORTE_DE_32_CARACTERES_OU_MAIS

# BANCO DE DADOS
# ==============
# Para PostgreSQL (RECOMENDADO para produção)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# Para SQLite (apenas desenvolvimento/teste)
# DATABASE_URL=sqlite:///instance/production.db

# STEAM API
# =========
STEAM_API_KEY=SUA_CHAVE_STEAM_API_AQUI
STEAM_WEB_API_KEY=SUA_CHAVE_STEAM_WEB_API_AQUI

# CONFIGURAÇÕES DE SEGURANÇA
# ===========================
# Domínio da aplicação (para CSRF e cookies seguros)
SERVER_NAME=seudominio.com

# Configuração de cookies seguros
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# Tempo de vida da sessão (em segundos) - 24 horas
PERMANENT_SESSION_LIFETIME=86400

# CORS (se necessário para API)
CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com

# CONFIGURAÇÕES DE EMAIL (se usar notificações)
# ==============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app

# CONFIGURAÇÕES DE RATE LIMITING
# ===============================
# Redis para rate limiting (recomendado)
REDIS_URL=redis://localhost:6379/0

# Configurações de rate limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/0
RATELIMIT_DEFAULT=100/hour

# CONFIGURAÇÕES DE LOGGING
# =========================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/app/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CONFIGURAÇÕES DE MONITORAMENTO
# ===============================
# Sentry para monitoramento de erros (opcional)
SENTRY_DSN=https://sua-chave-sentry@sentry.io/projeto

# New Relic para monitoramento de performance (opcional)
NEW_RELIC_LICENSE_KEY=sua-chave-new-relic

# CONFIGURAÇÕES DE BACKUP
# ========================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=seu-bucket-s3
AWS_ACCESS_KEY_ID=sua-chave-aws
AWS_SECRET_ACCESS_KEY=sua-chave-secreta-aws

# CONFIGURAÇÕES DE CACHE
# =======================
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=300

# CONFIGURAÇÕES SSL/TLS
# ======================
SSL_CERT_PATH=/etc/ssl/certs/seudominio.crt
SSL_KEY_PATH=/etc/ssl/private/seudominio.key

# CONFIGURAÇÕES DE FIREWALL
# ==========================
ALLOWED_IPS=127.0.0.1,::1,ip-do-servidor-autorizado

# CONFIGURAÇÕES DE WORKER (para deploy com Gunicorn)
# ===================================================
WEB_CONCURRENCY=2
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=30
KEEP_ALIVE=2

# CONFIGURAÇÕES DE HEALTHCHECK
# =============================
HEALTHCHECK_ENDPOINT=/health
HEALTHCHECK_SECRET=chave-secreta-para-healthcheck
